{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "ui": "@/components/ui",
      "note": "Compose from shadcn/ui with theme tokens and component variants."
    }
  },
  "rules": {
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^Sidebar(MenuButton|Header|Footer|Group.*)$",
            "allow": ["layout", "spacing", "opacity"]
          },
          {
            "pattern": "^Card.*$",
            "allow": ["layout", "spacing", "shadow-none"]
          },
          {
            "pattern": "^Avatar.*$",
            "allow": [
              "layout",
              "rounded-lg",
              "bg-sidebar-primary",
              "text-sidebar-primary-foreground"
            ]
          },
          {
            "pattern": "^DropdownMenuLabel$",
            "allow": ["layout", "font-normal"]
          }
        ]
      }
    ],
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-unknown-classes": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/src/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/require-static-classes": "off",
        "shadcn/no-unknown-classes": "off"
      }
    }
  ]
}
